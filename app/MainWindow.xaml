<Window x:Class="WindowsAntifyProxy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:WindowsAntifyProxy.Converters"
        mc:Ignorable="d"
        Title="Windows Antify Proxy" Height="780" Width="1180"
        Icon="antify-logo.png"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:HexToBrushConverter x:Key="HexToBrush"/>

        <!-- Windows 11 Caption Control Buttons -->
        <Style x:Key="WinCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F2F34"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCaptionCloseButton" TargetType="Button" BasedOn="{StaticResource WinCaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Style Toggle Switch -->
        <Style x:Key="WindowsSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20">
                            <Border x:Name="Track" Background="#2B2B2E" BorderBrush="#55555A" BorderThickness="1" CornerRadius="10">
                                <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="#D1D1D6" 
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0078D4"/>
                                <Setter TargetName="Track" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#88888F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Sidebar Item Button -->
        <Style x:Key="WinSidebarItemButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0B0B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="AccentPill" Width="3" Height="16" Background="#0078D4" 
                                    HorizontalAlignment="Left" VerticalAlignment="Center" 
                                    CornerRadius="1.5" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26262B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F2F36"/>
                                <Setter TargetName="AccentPill" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Standard Button -->
        <Style x:Key="WinStandardButton" TargetType="Button">
            <Setter Property="Background" Value="#2B2B30"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#383840"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#555560"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#232328"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Primary Blue Accent Button -->
        <Style x:Key="WinPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A86D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#006CBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3E3E48"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="border" Property="Background" Value="#222227"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Dark Mode ComboBox Item -->
        <Style x:Key="WinDarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" Margin="2,1" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#383842"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A4A7A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="WinDarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Border" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="#888892" 
                          HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#32323A"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#555562"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Windows 11 Dark Mode ComboBox -->
        <Style x:Key="WinDarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#25252A"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#3E3E48"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource WinDarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource WinDarkComboBoxToggleButton}" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>
                            <ContentPresenter IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="10,0,24,0" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   Placement="Bottom" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Border Background="#1C1C20" 
                                        BorderBrush="#383842" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        MinWidth="{TemplateBinding ActualWidth}" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                        Margin="0,3,0,0" 
                                        Padding="3">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Icon Nav Button (Used for sidebar toggle) -->
        <Style x:Key="WinIconNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A32"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222228"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Window Canvas with Native Windows 11 Dark Aesthetic -->
    <Border Background="#1C1C1F" CornerRadius="8" BorderBrush="#383840" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- 2 Main Rows: Title Bar + Main Content Area -->
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= WINDOW TITLE BAR (Windows 11 Controls) ================= -->
            <Border Grid.Row="0" Background="#18181A" BorderBrush="#2C2C30" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="antify-logo.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Windows Antify Proxy" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border Background="#1E3A5F" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0" FontSize="10" Foreground="#60CDFF" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Top Right Caption Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WinCaptionButton}" Click="WindowMinimize_Click" ToolTip="Minimize">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#D1D1D6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource WinCaptionButton}" Click="WindowMaximize_Click" ToolTip="Maximize">
                            <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#D1D1D6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource WinCaptionCloseButton}" Click="WindowClose_Click" ToolTip="Close">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#D1D1D6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN BODY ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" x:Name="SidebarColumn"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT SIDEBAR ================= -->
                <Border x:Name="SidebarBorder" Grid.Column="0" Width="220" Background="#18181B" BorderBrush="#2A2A30" BorderThickness="0,0,1,0" CornerRadius="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Sidebar Brand & Collapse Toggle -->
                        <Border Grid.Row="0" BorderBrush="#26262B" BorderThickness="0,0,0,1" Padding="12,12,10,12">
                            <Grid>
                                <!-- Expanded Brand State -->
                                <Grid x:Name="SidebarExpandedBrand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="antify-logo.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Antify" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Windows Edition" FontSize="10" Foreground="#60CDFF" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource WinIconNavButton}" Width="28" Height="28" 
                                            Click="ToggleSidebar_Click" ToolTip="Collapse Sidebar">
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="16" Height="16">
                                                <Rectangle Width="14" Height="14" Canvas.Left="1" Canvas.Top="1" RadiusX="2.5" RadiusY="2.5" 
                                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                                           StrokeThickness="1.5" Fill="Transparent"/>
                                                <Line X1="5.5" Y1="1" X2="5.5" Y2="15" 
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                                      StrokeThickness="1.5"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>

                                <!-- Collapsed Brand State -->
                                <StackPanel x:Name="SidebarCollapsedBrand" Visibility="Collapsed" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource WinIconNavButton}" Width="32" Height="32" 
                                            Click="ToggleSidebar_Click" ToolTip="Expand Sidebar">
                                        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="16" Height="16">
                                                <Rectangle Width="14" Height="14" Canvas.Left="1" Canvas.Top="1" RadiusX="2.5" RadiusY="2.5" 
                                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                                           StrokeThickness="1.5" Fill="Transparent"/>
                                                <Line X1="5.5" Y1="1" X2="5.5" Y2="15" 
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                                      StrokeThickness="1.5"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Nav List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,10">
                            <StackPanel>
                                <RadioButton x:Name="NavDashboard" Style="{StaticResource WinSidebarItemButton}" 
                                             GroupName="NavMenu" IsChecked="True" Click="Nav_Click" Tag="Dashboard" ToolTip="Dashboard">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock x:Name="IconNavDashboard" Text="&#xF246;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#60CDFF" Width="22" TextAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtNavDashboard" Text="Dashboard" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <TextBlock x:Name="HeaderConfig" Text="ROUTING &amp; RULES" FontSize="10" FontWeight="Bold" Foreground="#A1A1AA" Margin="8,14,0,4"/>

                                <RadioButton x:Name="NavRules" Style="{StaticResource WinSidebarItemButton}" 
                                             GroupName="NavMenu" Click="Nav_Click" Tag="Rules" ToolTip="Rules">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock x:Name="IconNavRules" Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#60CDFF" Width="22" TextAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtNavRules" Text="Rules" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavProxies" Style="{StaticResource WinSidebarItemButton}" 
                                             GroupName="NavMenu" Click="Nav_Click" Tag="Proxies" ToolTip="Proxies">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock x:Name="IconNavProxies" Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#60CDFF" Width="22" TextAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtNavProxies" Text="Proxies" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <TextBlock x:Name="HeaderSystem" Text="SYSTEM &amp; LOGS" FontSize="10" FontWeight="Bold" Foreground="#A1A1AA" Margin="8,14,0,4"/>

                                <RadioButton x:Name="NavActivity" Style="{StaticResource WinSidebarItemButton}" 
                                             GroupName="NavMenu" Click="Nav_Click" Tag="Activity" ToolTip="Activity &amp; Logs">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock x:Name="IconNavActivity" Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#60CDFF" Width="22" TextAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtNavActivity" Text="Activity &amp; Logs" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavSettings" Style="{StaticResource WinSidebarItemButton}" 
                                             GroupName="NavMenu" Click="Nav_Click" Tag="Settings" Margin="0,4,0,0" ToolTip="Settings">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock x:Name="IconNavSettings" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#60CDFF" Width="22" TextAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtNavSettings" Text="Settings" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Feedback Link -->
                        <Border Grid.Row="2" Padding="8,10" BorderBrush="#2A2A30" BorderThickness="0,1,0,0">
                            <Button x:Name="BtnFeedback" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Feedback_Click" ToolTip="Feedback &amp; Issues">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock x:Name="IconFeedback" Text="&#xED15;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#60CDFF" Width="22" TextAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtFeedback" Text="Feedback &amp; Issues" FontSize="12" Foreground="#D1D1D6" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= RIGHT CONTENT AREA ================= -->
                <Grid Grid.Column="1" Background="#202024">

                    <!-- ================= 1. RULES VIEW ================= -->
                    <Grid x:Name="ViewRules" Margin="24,18,24,20" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Title + Quick Live Proxy Status -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rules" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                            <!-- Live Proxy Status Pill in Top Bar -->
                            <Border Grid.Column="1" Background="#18181C" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ProxyHealthDot" Width="8" Height="8" Fill="#4ADE80" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtProxyLiveStatus" Text="Proxy 127.0.0.1:7897: Checking..." FontSize="11" Foreground="#CCCCCC"/>
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0" Click="RefreshProxyHealth_Click" ToolTip="Ping Proxy Now">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#60CDFF" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Action Bar -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Active Profile Badge -->
                            <Border Grid.Column="0" Background="#24242A" BorderBrush="#35353C" BorderThickness="1" CornerRadius="5" Padding="10,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEC32;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#60CDFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtActiveConfigName" Text="Default Profile" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <Border Background="#1C3825" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                        <TextBlock Text="Active" FontSize="10" Foreground="#4ADE80" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Right Actions: Import, Export, Launch Selection & Now, + Add Rule -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource WinStandardButton}" Margin="0,0,8,0" Click="Import_Click" ToolTip="Import Rules &amp; Proxies">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#60CDFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Import" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WinStandardButton}" Margin="0,0,8,0" Click="Export_Click" ToolTip="Export Backup Configuration">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#60CDFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Export" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <ComboBox x:Name="RulesHeaderLaunchTarget" 
                                          ItemsSource="{Binding Settings.Rules}"
                                          SelectedItem="{Binding SelectedLaunchRule, Mode=TwoWay}"
                                          Height="28" Width="165" Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource WinDarkComboBox}"
                                          ToolTip="Select which application to launch with 'Launch Now'">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{Binding CachedIcon}" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Style="{StaticResource WinPrimaryButton}" Margin="0,0,8,0" Click="TopBarLaunch_Click" ToolTip="{Binding TopBarLaunchToolTip}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Launch Now" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WinStandardButton}" Click="AddRule_Click" ToolTip="Add Application Rule">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#4ADE80" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Add Rule" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Rules Table Surface -->
                        <Border Grid.Row="2" Background="#26262B" BorderBrush="#323238" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Table Header -->
                                <Border Grid.Row="0" Background="#222226" BorderBrush="#323238" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>  <!-- Enabled -->
                                            <ColumnDefinition Width="220"/> <!-- Application -->
                                            <ColumnDefinition Width="65"/>  <!-- Type -->
                                            <ColumnDefinition Width="80"/>  <!-- Action -->
                                            <ColumnDefinition Width="150"/> <!-- Proxy -->
                                            <ColumnDefinition Width="130"/> <!-- Status -->
                                            <ColumnDefinition Width="*"/>   <!-- Actions -->
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Enabled" FontSize="11" Foreground="#888890" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="Application" FontSize="11" Foreground="#888890" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Type" FontSize="11" Foreground="#888890" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="Action" FontSize="11" Foreground="#888890" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="Proxy" FontSize="11" Foreground="#888890" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="Process Status" FontSize="11" Foreground="#888890" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="Actions" FontSize="11" Foreground="#888890" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                </Border>

                                <!-- Table Rows Scroll -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Settings.Rules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#303036" BorderThickness="0,0,0,1" Padding="0,10" Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="65"/>  <!-- Enabled -->
                                                                <ColumnDefinition Width="220"/> <!-- Application -->
                                                                <ColumnDefinition Width="65"/>  <!-- Type -->
                                                                <ColumnDefinition Width="80"/>  <!-- Action -->
                                                                <ColumnDefinition Width="150"/> <!-- Proxy -->
                                                                <ColumnDefinition Width="130"/> <!-- Status -->
                                                                <ColumnDefinition Width="*"/>   <!-- Actions -->
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Enabled Toggle (Active Proxy Control) -->
                                                            <CheckBox Grid.Column="0" Style="{StaticResource WindowsSwitchStyle}" 
                                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="12,0,0,0"
                                                                      Click="RuleEnabled_Click"
                                                                      ToolTip="Enable or disable proxy routing for this app"/>

                                                            <!-- Application (Icon + Name + Subtitle) -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Width="30" Height="30" CornerRadius="5" Background="#202024" BorderBrush="#3A3A42" BorderThickness="1" Margin="0,0,10,0">
                                                                    <Image Source="{Binding CachedIcon}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#888890" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Type Badge -->
                                                            <Border Grid.Column="2" Background="#1A2D3D" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Type}" FontSize="11" Foreground="#60CDFF" FontWeight="SemiBold"/>
                                                            </Border>

                                                            <!-- Action (Dot + Text) -->
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="7" Height="7" Fill="{Binding ActionColor, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding ActionText}" FontSize="12" Foreground="#FFFFFF"/>
                                                            </StackPanel>

                                                            <!-- Proxy Info with Subtitle -->
                                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ProxyName}" FontSize="12" Foreground="#D1D1D6"/>
                                                                <TextBlock Text="http://127.0.0.1:7897" FontSize="10" Foreground="#60CDFF"/>
                                                            </StackPanel>

                                                            <!-- Live Process Status -->
                                                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="7" Height="7" Fill="{Binding RunningStatusColor, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding RunningStatusText}" FontSize="11" Foreground="#D1D1D6"/>
                                                            </StackPanel>

                                                            <!-- Dedicated Action Buttons: Launch Now, Stop, Restart, Shortcut, Config, Delete -->
                                                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                <!-- Prominent Launch Button (Keeps exact working logic) -->
                                                                <Button Style="{StaticResource WinPrimaryButton}" 
                                                                        Padding="9,4" Margin="0,0,5,0" Click="LaunchRule_Click"
                                                                        ToolTip="Launch Antigravity with isolated HTTP/HTTPS proxy">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding LaunchButtonText}" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>

                                                                <!-- Active Working Stop Button -->
                                                                <Button Style="{StaticResource WinStandardButton}" 
                                                                        Foreground="#F87171" Padding="7,4" Margin="0,0,5,0" Click="StopRule_Click"
                                                                        ToolTip="Stop/Kill all running instances of this app">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#F87171" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Stop" FontSize="11" Foreground="#F87171" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>

                                                                <!-- Active Working Restart Button -->
                                                                <Button Style="{StaticResource WinStandardButton}" 
                                                                        Foreground="#60CDFF" Padding="7,4" Margin="0,0,5,0" Click="RestartRule_Click"
                                                                        ToolTip="Restart app with isolated proxy environment">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#60CDFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Restart" FontSize="11" Foreground="#60CDFF" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>

                                                                <!-- Inline Configure Button -->
                                                                <Button Style="{StaticResource WinStandardButton}" 
                                                                        Padding="7,4" Margin="0,0,5,0" Click="EditRule_Click"
                                                                        ToolTip="Configure isolated environment variables &amp; proxy">
                                                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#D1D1D6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Button>

                                                                <!-- Delete -->
                                                                <Button Style="{StaticResource WinStandardButton}" 
                                                                        Foreground="#F87171" Padding="7,4" Click="DeleteRule_Click"
                                                                        ToolTip="Delete rule">
                                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Blank Rows -->
                                        <Border Height="36" Background="#242428" BorderBrush="#2E2E34" BorderThickness="0,0,0,1"/>
                                        <Border Height="36" Background="#26262B" BorderBrush="#2E2E34" BorderThickness="0,0,0,1"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= 2. PROXIES VIEW ================= -->
                    <Grid x:Name="ViewProxies" Margin="24,18,24,20" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Proxies" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource WinPrimaryButton}" Click="TestAllProxies_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ping / Test Latency" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource WinPrimaryButton}" Click="AddProxy_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add Proxy" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="2" Background="#26262B" BorderBrush="#323238" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#222226" BorderBrush="#323238" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Name" FontSize="11" Foreground="#888890" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="Type" FontSize="11" Foreground="#888890" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Server Endpoint" FontSize="11" Foreground="#888890" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="Latency" FontSize="11" Foreground="#888890" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="Health" FontSize="11" Foreground="#888890" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="Actions" FontSize="11" Foreground="#888890" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Settings.Proxies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#303036" BorderThickness="0,0,0,1" Padding="0,10" Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="14,0,0,0"/>

                                                        <Border Grid.Column="1" Background="{Binding TypeBadgeColor, Converter={StaticResource HexToBrush}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{Binding TypeTextColor, Converter={StaticResource HexToBrush}}" FontWeight="SemiBold"/>
                                                        </Border>

                                                        <TextBlock Grid.Column="2" Text="{Binding ServerDisplay}" FontSize="12" Foreground="#D1D1D6" VerticalAlignment="Center"/>

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding LatencyColor, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding LatencyDisplay}" FontSize="12" Foreground="#FFFFFF"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="4" Text="{Binding Health}" FontSize="12" Foreground="#888890" VerticalAlignment="Center"/>

                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource WinStandardButton}" Padding="8,3" Margin="0,0,6,0" Click="TestProxyRow_Click" ToolTip="Test proxy latency">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#60CDFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Ping" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource WinStandardButton}" Padding="8,3" Margin="0,0,6,0" Click="EditProxyRow_Click" ToolTip="Configure Proxy">
                                                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#D1D1D6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <Button Style="{StaticResource WinStandardButton}" Foreground="#F87171" Padding="8,3" Click="DeleteProxyRow_Click" ToolTip="Delete Proxy">
                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= 3. DASHBOARD VIEW ================= -->
                    <Grid x:Name="ViewDashboard" Margin="24,18,24,20" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Dashboard Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Dashboard" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="System overview, live gateway telemetry and scoped routing status" FontSize="11" Foreground="#888892" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource WinStandardButton}" Padding="12,5" Margin="0,0,8,0" Click="RefreshProxyHealth_Click" ToolTip="Test proxy roundtrip latency now">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FBBF24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ping Gateway" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WinPrimaryButton}" Padding="14,5" Click="TopBarLaunch_Click" ToolTip="{Binding TopBarLaunchToolTip}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Launch App" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Master Proxy Routing Status Banner -->
                                <Border x:Name="DashMasterBanner" Background="#163825" BorderBrush="#235E3B" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="DashMasterIconBorder" Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1D4F31" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="DashMasterIcon" Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="DashMasterTitle" Text="Proxy Routing Active" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <Border Background="#1E3A5F" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Isolated Mode" FontSize="10" Foreground="#60CDFF" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="DashMasterSubtitle" Text="Isolated proxy environment engaged for configured applications (Antigravity). Windows system networking remains untouched." FontSize="12" Foreground="#B0B0B8" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="DashMasterToggleBtn" Style="{StaticResource WinStandardButton}" Padding="16,6" FontSize="12" 
                                                    Content="Pause Proxy" Click="ToggleMasterProxy_Click" ToolTip="Toggle proxy routing active/pause"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 3 Key Metric Cards -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Card 1: Target Application -->
                                    <Border Grid.Column="0" Background="#26262B" BorderBrush="#323238" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="TARGET APPLICATION" FontSize="10" FontWeight="Bold" Foreground="#6E6E78"/>
                                            <TextBlock x:Name="TxtDashTargetName" Text="Antigravity" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Ellipse x:Name="DotDashTargetStatus" Width="7" Height="7" Fill="#888892" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtDashTargetStatus" Text="Ready to Launch" FontSize="11" Foreground="#888892" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2: Primary Gateway -->
                                    <Border Grid.Column="1" Background="#26262B" BorderBrush="#323238" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="PRIMARY GATEWAY" FontSize="10" FontWeight="Bold" Foreground="#6E6E78"/>
                                            <TextBlock x:Name="TxtDashGatewayHost" Text="127.0.0.1:7897" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                                            <TextBlock Text="HTTP Proxy · Scoped Loopback" FontSize="11" Foreground="#60CDFF" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 3: Isolation Level -->
                                    <Border Grid.Column="2" Background="#26262B" BorderBrush="#323238" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ISOLATION LEVEL" FontSize="10" FontWeight="Bold" Foreground="#6E6E78"/>
                                            <TextBlock Text="Per-Process Environment" FontSize="15" FontWeight="Bold" Foreground="#C084FC" Margin="0,4,0,0"/>
                                            <TextBlock Text="Registry &amp; System Clean" FontSize="11" Foreground="#888892" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Gateway Latency & Response Graph (Live Telemetry Centerpiece) -->
                                <Border Background="#1E1E24" BorderBrush="#2F2F38" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="180"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Graph Card Header -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xEC19;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#60CDFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Gateway Latency &amp; Response Telemetry" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                                <TextBlock Text="Continuous TCP roundtrip response time to proxy gateway sampled every 3 seconds" FontSize="11" Foreground="#888892" Margin="23,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#1A3825" BorderBrush="#2A5E3B" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="6" Height="6" Fill="#4ADE80" Margin="0,0,6,0"/>
                                                        <TextBlock x:Name="TxtDashboardLiveBadge" Text="Live 1 ms" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Live Telemetry Metrics Strip -->
                                        <Border Grid.Row="1" Background="#16161A" BorderBrush="#282832" BorderThickness="1" CornerRadius="6" Padding="14,9" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="CURRENT" FontSize="9" FontWeight="Bold" Foreground="#6E6E78"/>
                                                    <TextBlock x:Name="TxtDashStatCurrent" Text="1 ms" FontSize="14" FontWeight="Bold" Foreground="#60CDFF" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="AVERAGE" FontSize="9" FontWeight="Bold" Foreground="#6E6E78"/>
                                                    <TextBlock x:Name="TxtDashStatAvg" Text="1.0 ms" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="MINIMUM" FontSize="9" FontWeight="Bold" Foreground="#6E6E78"/>
                                                    <TextBlock x:Name="TxtDashStatMin" Text="1 ms" FontSize="14" FontWeight="Bold" Foreground="#4ADE80" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="PEAK / MAX" FontSize="9" FontWeight="Bold" Foreground="#6E6E78"/>
                                                    <TextBlock x:Name="TxtDashStatMax" Text="2 ms" FontSize="14" FontWeight="Bold" Foreground="#FBBF24" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="PACKET LOSS" FontSize="9" FontWeight="Bold" Foreground="#6E6E78"/>
                                                    <TextBlock x:Name="TxtDashStatLoss" Text="0.0%" FontSize="14" FontWeight="Bold" Foreground="#4ADE80" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Latency Chart Canvas Surface -->
                                        <Grid Grid.Row="2" ClipToBounds="True">
                                            <Border Background="#121215" BorderBrush="#25252E" BorderThickness="1" CornerRadius="6">
                                                <Grid>
                                                    <Canvas x:Name="LatencyGraphCanvas" SizeChanged="LatencyGraphCanvas_SizeChanged" ClipToBounds="True"/>

                                                    <!-- Y-Axis Value Labels Overlay (left side) -->
                                                    <Grid IsHitTestVisible="False" VerticalAlignment="Stretch" HorizontalAlignment="Left" Margin="10,6,0,6">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock x:Name="TxtYMax" Grid.Row="0" Text="10 ms" FontSize="9" Foreground="#666675" FontFamily="Consolas, monospace"/>
                                                        <TextBlock x:Name="TxtYMid" Grid.Row="2" Text="5 ms" FontSize="9" Foreground="#666675" FontFamily="Consolas, monospace"/>
                                                        <TextBlock Grid.Row="4" Text="0 ms" FontSize="9" Foreground="#666675" FontFamily="Consolas, monospace"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- X-Axis Timeline Indicators -->
                                        <Grid Grid.Row="3" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="60s ago" FontSize="10" Foreground="#5E5E68"/>
                                            <TextBlock Grid.Column="2" Text="30s ago" FontSize="10" Foreground="#5E5E68"/>
                                            <TextBlock Grid.Column="4" Text="● Live" FontSize="10" Foreground="#60CDFF" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Two Columns: Variable Pipeline & Live Activity Feed -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column: Active Environment Variables Pipeline -->
                                    <Border Grid.Column="0" Background="#26262B" BorderBrush="#323238" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#4ADE80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Active Variable Pipeline" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                            <TextBlock Text="Injected strictly into child processes without modifying Windows system or user registry:" FontSize="11" Foreground="#888892" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                            <Border Background="#1C1C20" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="HTTP_PROXY" FontSize="10" FontWeight="Bold" Foreground="#60CDFF" FontFamily="Consolas, monospace"/>
                                                        <TextBlock Grid.Column="1" Text="http://127.0.0.1:7897" FontSize="11" Foreground="#4ADE80" FontFamily="Consolas, monospace"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="HTTPS_PROXY" FontSize="10" FontWeight="Bold" Foreground="#60CDFF" FontFamily="Consolas, monospace"/>
                                                        <TextBlock Grid.Column="1" Text="http://127.0.0.1:7897" FontSize="11" Foreground="#4ADE80" FontFamily="Consolas, monospace"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="NO_PROXY" FontSize="10" FontWeight="Bold" Foreground="#60CDFF" FontFamily="Consolas, monospace"/>
                                                        <TextBlock Grid.Column="1" Text="localhost, 127.0.0.1, ::1 (Bypass)" FontSize="10" Foreground="#CCCCCC" FontFamily="Consolas, monospace"/>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="ALL_PROXY" FontSize="10" FontWeight="Bold" Foreground="#A0A0A8" FontFamily="Consolas, monospace"/>
                                                        <TextBlock Grid.Column="1" Text="Unset (Protects internal Go runtime)" FontSize="10" Foreground="#888892" FontFamily="Consolas, monospace"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Right Column: Recent Activity Feed -->
                                    <Border Grid.Column="1" Background="#26262B" BorderBrush="#323238" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="8,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FBBF24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Recent Events &amp; Audit" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" x:Name="DashboardRecentLogContainer" Margin="0,0,0,8"/>

                                            <Button Grid.Row="2" Content="View Full Activity Logs →" Style="{StaticResource WinStandardButton}" 
                                                    HorizontalAlignment="Right" Padding="10,4" FontSize="11" Click="DashboardViewLogs_Click" ToolTip="Open Activity &amp; Execution Logs tab"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ================= 6. ACTIVITY & LOGS VIEW ================= -->
                    <Grid x:Name="ViewActivity" Margin="24,18,24,20" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Activity &amp; Execution Logs" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ActivityLogContainer"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- ================= 7. SETTINGS VIEW ================= -->
                    <Grid x:Name="ViewSettings" Margin="24,18,24,20" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Settings" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="#26262B" BorderBrush="#323238" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Windows Explorer Right-Click Context Menu" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Add 'Run with Windows Antify Proxy' to the right-click menu for all .exe files" FontSize="11" Foreground="#888890" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource WindowsSwitchStyle}" 
                                                  IsChecked="{Binding Settings.ExplorerContextMenu, Mode=TwoWay}"
                                                  Click="ExplorerContextMenu_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="#26262B" BorderBrush="#323238" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Auto-Guardian Background Enforcer" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Automatically monitors Antigravity and prompts/ensures proxy variables are applied on external launches" FontSize="11" Foreground="#888890" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource WindowsSwitchStyle}" 
                                                  IsChecked="{Binding Settings.AutoEnforceProxy, Mode=TwoWay}"
                                                  Click="AutoGuardian_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="#162736" BorderBrush="#23425F" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#60CDFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Environment Isolation (Active)" FontSize="13" FontWeight="SemiBold" Foreground="#60CDFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Variables HTTP_PROXY and HTTPS_PROXY are passed exclusively into Antigravity upon execution. The Windows user account environment variables remain completely unpolluted." 
                                                   FontSize="11" Foreground="#A0C8E8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#26262B" BorderBrush="#323238" BorderThickness="1" CornerRadius="6" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Configuration Storage" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Stored in %APPDATA%\WindowsAntifyProxy\config.json" FontSize="11" Foreground="#888890" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Open Folder" Style="{StaticResource WinStandardButton}" Click="OpenConfigFolder_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

            <!-- ================= INLINE MODAL OVERLAYS (NO FLOATING POPUP WINDOWS!) ================= -->

            <!-- 1. Inline Rule Config Drawer / Modal -->
            <Grid x:Name="InlineRuleModal" Grid.Row="0" Grid.RowSpan="2" Background="#99000000" Visibility="Collapsed">
                <Border Background="#1E1E22" BorderBrush="#3A3A44" BorderThickness="1" CornerRadius="8" 
                        Width="620" MaxHeight="660" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Modal Header -->
                        <Border Grid.Row="0" Background="#18181B" BorderBrush="#2A2A30" BorderThickness="0,0,0,1" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtModalTitle" Text="Configure Application Rule" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Manage scoped proxy routing and isolated user-level environment variables" FontSize="11" Foreground="#888890" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource WinStandardButton}" Width="28" Height="28" Padding="0" Click="CloseInlineModal_Click">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#D1D1D6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Modal Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel>
                                <TextBlock Text="TARGET APPLICATION" FontSize="10" FontWeight="Bold" Foreground="#60CDFF" Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ModalTxtExePath" Style="{StaticResource InputTextBoxStyle}"/>
                                    <Button Grid.Column="1" Content="Browse .exe..." Style="{StaticResource WinStandardButton}" Margin="8,0,0,0" Click="ModalBrowseExe_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Display Name" FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ModalTxtName" Style="{StaticResource InputTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Rule Subtitle / Notes" FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ModalTxtSubtitle" Style="{StaticResource InputTextBoxStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Action -->
                                <TextBlock Text="ROUTING ACTION" FontSize="10" FontWeight="Bold" Foreground="#60CDFF" Margin="0,0,0,6"/>
                                <Border Background="#26262B" BorderBrush="#323238" BorderThickness="1" CornerRadius="5" Padding="4" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="ModalRbProxy" Grid.Column="0" Content="● Proxy" GroupName="ModalAction" Foreground="#FFFFFF" IsChecked="True" HorizontalAlignment="Center"/>
                                        <RadioButton x:Name="ModalRbDirect" Grid.Column="1" Content="● Direct" GroupName="ModalAction" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                        <RadioButton x:Name="ModalRbBlock" Grid.Column="2" Content="● Block" GroupName="ModalAction" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Assigned Proxy -->
                                <TextBlock Text="ASSIGNED PROXY" FontSize="10" FontWeight="Bold" Foreground="#60CDFF" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ModalCmbProxy" Height="34" Margin="0,0,0,14"
                                          Style="{StaticResource WinDarkComboBox}"
                                          ItemsSource="{Binding Settings.Proxies}"
                                          DisplayMemberPath="Name" SelectedValuePath="Name"/>

                                <!-- Scoped Environment Variables Table -->
                                <Border BorderBrush="#323238" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,6,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="ISOLATED ENVIRONMENT VARIABLES" FontSize="10" FontWeight="Bold" Foreground="#4ADE80"/>
                                            <TextBlock Text="These variables apply ONLY when this app runs, keeping Windows clean:" FontSize="11" Foreground="#888890" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource WinStandardButton}" Padding="8,3" FontSize="11" Click="ModalAddEnvVar_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#4ADE80" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Add Variable" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <ItemsControl x:Name="ModalEnvVarsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" 
                                                          Style="{StaticResource WindowsSwitchStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding Key, Mode=TwoWay}" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay}" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,6,0"/>
                                                <Button Grid.Column="3" Width="26" Height="26" Style="{StaticResource WinStandardButton}" 
                                                        Foreground="#F87171" Padding="0" Click="ModalDeleteEnvVar_Click" ToolTip="Remove variable">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Modal Footer -->
                        <Border Grid.Row="2" Background="#18181B" BorderBrush="#2A2A30" BorderThickness="0,1,0,0" Padding="18,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <Button Style="{StaticResource WinStandardButton}" Click="ModalLaunchNow_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#60CDFF" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Launch Now" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Grid.Column="2">
                                    <Button Content="Cancel" Style="{StaticResource WinStandardButton}" Margin="0,0,8,0" Click="CloseInlineModal_Click"/>
                                    <Button Content="Save Rule" Style="{StaticResource WinPrimaryButton}" Click="ModalSaveRule_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. Kill Switch Alert Modal (Triggered when Proxy is Offline!) -->
            <Grid x:Name="InlineKillSwitchAlert" Grid.Row="0" Grid.RowSpan="2" Background="#B3000000" Visibility="Collapsed">
                <Border Background="#201518" BorderBrush="#A52A2A" BorderThickness="1.5" CornerRadius="8" 
                        Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="36" Height="36" CornerRadius="6" Background="#4A181C" Margin="0,0,12,0">
                                <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Kill Switch Engaged" FontSize="16" FontWeight="Bold" Foreground="#F87171"/>
                                <TextBlock Text="Proxy Unreachable — IP Leak Protected" FontSize="11" Foreground="#CCCCCC"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="TxtKillSwitchMsg" 
                                   Text="Local Proxy (127.0.0.1:7897) is currently offline or unreachable. Launch was stopped to ensure your true IP address does not leak to the destination."
                                   FontSize="12" Foreground="#D1D1D6" TextWrapping="Wrap" Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Retry / Ping Proxy" Style="{StaticResource WinStandardButton}" 
                                    HorizontalAlignment="Left" Click="KillSwitchRetry_Click"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Dismiss" Style="{StaticResource WinStandardButton}" Margin="0,0,8,0" Click="KillSwitchDismiss_Click"/>
                                <Button Content="Force Launch (Null Sink)" Style="{StaticResource WinStandardButton}" Foreground="#F87171" Click="KillSwitchForceLaunch_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Sleek In-Window Toast Banner (Top Right) -->
            <Border x:Name="InlineToast" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,44,24,0" Background="#26262B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" 
                    Padding="14,10" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtToastIcon" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4ADE80" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtToastMessage" Text="Action completed" FontSize="12" Foreground="#FFFFFF"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
